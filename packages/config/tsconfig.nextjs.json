{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Overrides tsconfig.base.json's Node-library-oriented `lib` (ES2022
    // only) — a Next.js app renders in the browser too and needs DOM types
    // (HTMLSelectElement, ChangeEvent's target, etc.), unlike the plain
    // Node library packages tsconfig.lib.json is for.
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  }
}
