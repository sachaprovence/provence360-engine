# v1.0.1 — brief SUJET D: this file is grouped by WHICH PROCESS actually
# consumes each variable, not just by topic — see
# packages/validation/src/env.ts's webEnvSchema/adminEnvSchema/
# workerEnvSchema (built from a real audit of each app's imports) and this
# release's final report, PER-PROCESS ENVIRONMENT VALIDATION, for the exact
# trace. Every process still reads from this same single `.env` file in
# local dev — the grouping below is about what each one actually validates
# and needs, not a claim that these ship as four separate files.

# --- Shared (every process) -------------------------------------------------
NODE_ENV="development"

# --- Database connections ---------------------------------------------------
# Four distinct roles, four distinct connection strings. Never collapse
# these into one — see docs/SECURITY.md and docs/AUTHENTICATION.md. Each
# one below is only actually needed by the process(es) noted — see
# docs/DEPLOYMENT.md, "What runs where" for the full table.

# Migration/seed scripts ONLY (db:migrate, db:setup-roles, db:seed) — never
# apps/web, apps/admin, or apps/worker. Owns the schema, bypasses Row-Level
# Security (table owner). MUST NEVER be used to serve a request.
DATABASE_URL="postgresql://provence360:provence360@localhost:5432/provence360_dev"

# apps/web + apps/admin. Tenant-scoped runtime role. Every query issued
# through this connection is subject to RLS policies keyed on
# `current_setting('app.tenant_id')`. All request-serving repositories
# (packages/sites, packages/domains write paths, membership/audit-log
# access) use this connection, always via `withTenantContext()` from
# packages/tenant. Never needed by apps/worker (no database access yet —
# see apps/worker/src/index.ts's own doc comment).
DATABASE_URL_APP="postgresql://provence360_app:provence360_app@localhost:5432/provence360_dev"

# apps/web + apps/admin. Narrow, read-only role used exclusively by the
# hostname -> site -> tenant resolver (packages/domains/resolver.ts) and by
# both apps' /health/ready check. Column-restricted grants: it can only
# ever see routing metadata (ids, hostnames, status), never tenant content.
DATABASE_URL_RESOLVER="postgresql://provence360_resolver:provence360_resolver@localhost:5432/provence360_dev"

# apps/admin ONLY (never apps/web — web has no login). Session validation,
# login, and membership/authorization lookups, all of which have to run
# *before* a tenant is known (see docs/AUTHENTICATION.md,
# docs/AUTHORIZATION.md). Column-restricted grants: sessions (owns the
# table outright), users (email, name, password_hash for login; never
# readable by DATABASE_URL_APP), memberships (read-only, for the
# authorization check and tenant switcher), tenants (id/slug/name/status
# only), audit_logs (insert/read restricted to tenant_id IS NULL —
# platform-level events only).
DATABASE_URL_AUTH="postgresql://provence360_auth:provence360_auth@localhost:5432/provence360_dev"

# --- Web & Admin (platform config) ------------------------------------------
# Root domain of the platform. Hosts of the form <slug>.ROOT_DOMAIN resolve
# to a site by subdomain; any other host is looked up as a custom domain.
# Not needed by apps/worker (it never resolves a hostname).
ROOT_DOMAIN="provence360.app"

# --- Worker ------------------------------------------------------------------
# apps/worker is a v0.1 placeholder (heartbeat only — see its own doc
# comment) and needs nothing beyond the Shared section above today. This
# section exists so the day it gains a real job needing its own
# configuration, there's an obvious place for it — see docs/ROADMAP.md.

# --- Media / S3 (apps/web + apps/admin) -------------------------------------
# See docs/MEDIA.md and docs/adr/0022-media-ingestion-asset-delivery.md.
# Not needed by apps/worker (it never touches storage).
# "memory" (the default — this line can be omitted entirely) needs no other
# variable: an in-process, non-persistent object store, correct for local
# dev and every automated test, never for a real deployment (uploaded bytes
# do not survive a server restart, and are not shared across separate
# processes — see docs/MEDIA.md's "Local development" section).
# NODE_ENV=production + MEDIA_STORAGE_PROVIDER=memory (or unset) fails
# loudly (v0.9.1: at first use; v1.0: eagerly, at process startup — see
# docs/DEPLOYMENT.md, "Configuration & production guard-rails") —
# production must set "s3" below.
MEDIA_STORAGE_PROVIDER="memory"

# v1.0: NEVER set this in a real deployment. The one deliberate escape
# hatch from the production+memory-storage guard above, reserved for the
# admin/web Playwright E2E `webServer` configs, which legitimately run
# NODE_ENV=production (for build realism) against the seeded dev database
# without being a real deployment. See docs/DEPLOYMENT.md.
# MEDIA_ALLOW_MEMORY_IN_PRODUCTION="true"

# Uncomment and fill in to use a real S3-compatible backend instead
# (MEDIA_STORAGE_PROVIDER=s3 requires S3_REGION/S3_BUCKET/S3_ACCESS_KEY_ID/
# S3_SECRET_ACCESS_KEY — loadMediaEnv() throws at startup if any is missing):
# MEDIA_STORAGE_PROVIDER="s3"
# S3_REGION="us-east-1"
# S3_BUCKET="your-bucket-name"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# Only needed for a non-AWS endpoint (Cloudflare R2, MinIO, s3rver, ...):
# S3_ENDPOINT="https://..."
# v1.0.1: defaults to "true" automatically the moment S3_ENDPOINT is set
# (loadMediaEnv() — no self-hosted/non-AWS provider has real DNS for
# virtual-hosted-style addressing). Uncomment only to override that default,
# e.g. to force "false" against a non-AWS endpoint that genuinely supports
# virtual-hosted-style addressing.
# S3_FORCE_PATH_STYLE="true"

# v1.0.2: for the concrete Cloudflare R2 values (S3_REGION="auto",
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", a scoped R2
# API token for S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY) and how to validate
# them for real before a first deploy, see docs/RAILWAY.md.

# --- Production bootstrap (one-shot, never left in .env) -------------------
# `pnpm db:bootstrap-production` (packages/database/src/scripts/
# bootstrap-production.ts, v1.0.2) creates the first real owner/tenant/site
# — never `pnpm db:seed`, which is dev/test fixture data only (see above).
# Its BOOTSTRAP_OWNER_EMAIL/BOOTSTRAP_OWNER_NAME/BOOTSTRAP_OWNER_PASSWORD/
# BOOTSTRAP_TENANT_SLUG/BOOTSTRAP_TENANT_NAME/BOOTSTRAP_SITE_SLUG/
# BOOTSTRAP_SITE_NAME/BOOTSTRAP_DOMAIN_HOSTNAME variables are deliberately
# NOT listed here with placeholders: they're one-shot values for a single
# invocation against a real target, not standing local-dev configuration —
# see docs/RAILWAY.md, "Bootstrap the first tenant" for the full command.
