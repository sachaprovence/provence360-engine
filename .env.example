# --- Database connections -------------------------------------------------
# Four distinct roles, four distinct connection strings. Never collapse
# these into one — see docs/SECURITY.md and docs/AUTHENTICATION.md.

# Owns the schema. Runs migrations and the dev seed only. Bypasses Row-Level
# Security (table owner). MUST NEVER be used to serve a request.
DATABASE_URL="postgresql://provence360:provence360@localhost:5432/provence360_dev"

# Tenant-scoped runtime role. Every query issued through this connection is
# subject to RLS policies keyed on `current_setting('app.tenant_id')`. All
# request-serving repositories (packages/sites, packages/domains write paths,
# membership/audit-log access) use this connection, always via
# `withTenantContext()` from packages/tenant.
DATABASE_URL_APP="postgresql://provence360_app:provence360_app@localhost:5432/provence360_dev"

# Narrow, read-only role used exclusively by the hostname -> site -> tenant
# resolver (packages/domains/resolver.ts). Column-restricted grants: it can
# only ever see routing metadata (ids, hostnames, status), never tenant
# content. This is one of two deliberate, reviewed exceptions to "no query
# without tenant context" and it is not usable for anything else.
DATABASE_URL_RESOLVER="postgresql://provence360_resolver:provence360_resolver@localhost:5432/provence360_dev"

# The other deliberate exception: session validation, login, and
# membership/authorization lookups all have to run *before* a tenant is
# known (see docs/AUTHENTICATION.md, docs/AUTHORIZATION.md). Column-
# restricted grants: sessions (owns the table outright), users (email,
# name, password_hash for login; never readable by DATABASE_URL_APP),
# memberships (read-only, for the authorization check and tenant
# switcher), tenants (id/slug/name/status only), audit_logs (insert/read
# restricted to tenant_id IS NULL — platform-level events only).
DATABASE_URL_AUTH="postgresql://provence360_auth:provence360_auth@localhost:5432/provence360_dev"

# --- Platform ---------------------------------------------------------------
# Root domain of the platform. Hosts of the form <slug>.ROOT_DOMAIN resolve
# to a site by subdomain; any other host is looked up as a custom domain.
ROOT_DOMAIN="provence360.app"

NODE_ENV="development"
